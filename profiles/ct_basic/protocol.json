{
  "config_version": "ct-basic-v1",
  "_comment": "Profile ct_basic: a general CT viewer without segmentation; the default profile. submit_report takes the built-in JSON report unless the harness passes its own (`slicer-mcp serve --report`). Its sha256 goes into every trace, and the server refuses a bridge that loaded another one.",
  "mcp": {
    "server_name": "slicer-mcp",
    "instructions_title": "CT viewer.",
    "tools": [
      "reset_view",
      "bookmark_view",
      "submit_report",
      "set_slice",
      "scroll_slice",
      "set_window_preset",
      "jump_to_point",
      "point_at",
      "orbit",
      "set_view_direction",
      "zoom",
      "pan_to",
      "set_render_preset",
      "set_clip_box",
      "set_clip_plane",
      "clear_clip",
      "measure"
    ]
  },
  "observation": {
    "size_px": 512,
    "background_rgb": [
      0.0,
      0.0,
      0.0
    ],
    "vr_quality": "Normal",
    "expected_fps": 1.0,
    "oversampling": 1.0,
    "png_compression_level": 3,
    "state_decimals": 4,
    "render_mode": "Perspective",
    "raycast_technique": "Composite",
    "surface_smoothing": false,
    "ruler": "None",
    "orientation_marker": {
      "3d": {
        "type": "Human",
        "size": "Small"
      },
      "slices": {
        "type": "Human",
        "size": "Small"
      }
    }
  },
  "window_level": {
    "presets": {
      "CT-Soft-Tissue": [
        400.0,
        40.0
      ],
      "CT-Lung": [
        1400.0,
        -500.0
      ],
      "CT-Bone": [
        1500.0,
        450.0
      ],
      "CT-Angio": [
        700.0,
        200.0
      ],
      "CT-Brain": [
        80.0,
        40.0
      ]
    },
    "default_preset": "CT-Soft-Tissue",
    "colormap": "vtkMRMLColorTableNodeGrey",
    "interpolate": true
  },
  "render": {
    "_comment": "Slicer 5.10's own presets only (no extra_presets_xml).",
    "presets": [
      "CT-Chest-Contrast-Enhanced",
      "CT-Bone",
      "CT-Soft-Tissue",
      "CT-Coronary-Arteries-2"
    ],
    "default_preset": "CT-Chest-Contrast-Enhanced",
    "method": "vtkMRMLGPURayCastVolumeRenderingDisplayNode"
  },
  "slices": {
    "scroll_max_slices": 200
  },
  "slice_tools": {
    "zoom_range": [
      1.0,
      3.0
    ],
    "slab_mm_range": [
      0.0,
      20.0
    ],
    "measure_color_rgb": [
      0.98,
      0.84,
      0.0
    ],
    "measure_color_name": "yellow",
    "measure_line_thickness": 0.3,
    "hu_ball_radius_mm": 1.0
  },
  "camera": {
    "_comment": "Reset distance fits the volume's largest RAS extent E: (E/2)/tan(view_angle/2) + E/2, times reset_fit_margin.",
    "view_angle_deg": 30.0,
    "reset_fit_margin": 1.05,
    "orbit_azimuth_range": [
      -180.0,
      180.0
    ],
    "orbit_elevation_range": [
      -90.0,
      90.0
    ],
    "orbit_roll_range": [
      -180.0,
      180.0
    ],
    "zoom_cumulative_range": [
      0.25,
      4.0
    ],
    "zoom_step_range": [
      0.25,
      4.0
    ],
    "pan_margin_mm": 50.0,
    "default_view_direction": "anterior",
    "view_directions": {
      "anterior": {
        "from": [
          0.0,
          1.0,
          0.0
        ],
        "view_up": [
          0.0,
          0.0,
          1.0
        ]
      },
      "posterior": {
        "from": [
          0.0,
          -1.0,
          0.0
        ],
        "view_up": [
          0.0,
          0.0,
          1.0
        ]
      },
      "left": {
        "from": [
          -1.0,
          0.0,
          0.0
        ],
        "view_up": [
          0.0,
          0.0,
          1.0
        ]
      },
      "right": {
        "from": [
          1.0,
          0.0,
          0.0
        ],
        "view_up": [
          0.0,
          0.0,
          1.0
        ]
      },
      "superior": {
        "from": [
          0.0,
          0.0,
          1.0
        ],
        "view_up": [
          0.0,
          -1.0,
          0.0
        ]
      },
      "inferior": {
        "from": [
          0.0,
          0.0,
          -1.0
        ],
        "view_up": [
          0.0,
          1.0,
          0.0
        ]
      }
    }
  },
  "clip": {
    "box_min_size_mm": 5.0,
    "plane_offset_range_mm": [
      -200.0,
      200.0
    ],
    "plane_azimuth_range": [
      -180.0,
      180.0
    ],
    "plane_elevation_range": [
      -90.0,
      90.0
    ]
  }
}
