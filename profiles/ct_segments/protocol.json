{
  "config_version": "ct-segments-v1",
  "_comment": "Profile ct_segments: the general CT viewer plus a segmentation (a label map given at case preparation, shown as hollow shells) and the five segment tools. The class names are an example: a task brings its own profile. Its sha256 goes into every trace, and the server refuses a bridge that loaded another one.",
  "mcp": {
    "server_name": "slicer-mcp",
    "instructions_title": "CT viewer with segmented structures.",
    "tools": [
      "reset_view",
      "bookmark_view",
      "submit_report",
      "set_slice",
      "scroll_slice",
      "set_window_preset",
      "jump_to_point",
      "point_at",
      "orbit",
      "set_view_direction",
      "zoom",
      "pan_to",
      "set_render_preset",
      "set_clip_box",
      "set_clip_plane",
      "clear_clip",
      "set_segment_visibility",
      "set_segment_opacity",
      "set_3d_content",
      "set_slice_outlines",
      "center_on_segments",
      "measure"
    ]
  },
  "observation": {
    "size_px": 512,
    "background_rgb": [
      0.0,
      0.0,
      0.0
    ],
    "vr_quality": "Normal",
    "expected_fps": 1.0,
    "oversampling": 1.0,
    "png_compression_level": 3,
    "state_decimals": 4,
    "render_mode": "Perspective",
    "raycast_technique": "Composite",
    "surface_smoothing": false,
    "ruler": "None",
    "orientation_marker": {
      "3d": {
        "type": "Human",
        "size": "Small"
      },
      "slices": {
        "type": "Human",
        "size": "Small"
      }
    }
  },
  "window_level": {
    "presets": {
      "CT-Soft-Tissue": [
        400.0,
        40.0
      ],
      "CT-Lung": [
        1400.0,
        -500.0
      ],
      "CT-Bone": [
        1500.0,
        450.0
      ],
      "CT-Angio": [
        700.0,
        200.0
      ],
      "CT-Brain": [
        80.0,
        40.0
      ]
    },
    "default_preset": "CT-Soft-Tissue",
    "colormap": "vtkMRMLColorTableNodeGrey",
    "interpolate": true
  },
  "render": {
    "_comment": "Slicer 5.10's own presets only (no extra_presets_xml).",
    "presets": [
      "CT-Chest-Contrast-Enhanced",
      "CT-Bone",
      "CT-Soft-Tissue",
      "CT-Coronary-Arteries-2"
