          0.0,
          0.0,
          -1.0
        ],
        "view_up": [
          0.0,
          1.0,
          0.0
        ]
      }
    }
  },
  "clip": {
    "box_min_size_mm": 5.0,
    "plane_offset_range_mm": [
      -200.0,
      200.0
